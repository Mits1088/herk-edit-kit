# Personal inputs, transcripts, edit decisions, and renders stay local.
.env
.env.*
!.env.example
*.env
*.pem
*.key
node_modules/
raw-media/
video-projects/
renders/
**/renders/
**/assets/
tmp/
archives/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.zip
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.claude/settings.local.json
.codex/auth.json
.codex/sessions/
.codex/history.jsonl

# Deliberately public synthetic timing data, without media.
!examples/short-form/assets/
!examples/short-form/assets/*.json

# The default brand style's OFL fonts ship so every checkout renders the same type.
# Other brand assets (your own logos, licensed fonts) stay local.
!brand/assets/
brand/assets/*
!brand/assets/fonts/
brand/assets/fonts/*
!brand/assets/fonts/InterVariable.woff2
!brand/assets/fonts/OFL-Inter.txt
!brand/assets/fonts/JetBrainsMono-Regular.woff2
!brand/assets/fonts/OFL-JetBrainsMono.txt

# Three finished videos explicitly supplied for the public showcase.
!examples/showcase/curiosity-reel-2.mp4
!examples/showcase/curiosity-reel-1.mp4
!examples/showcase/ais-live-ad.mp4
